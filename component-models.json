  {
    "id": "teaser",
    "fields": [
      {
        "component": "richtext",
        "name": "title",
        "value": "Your text will show here.",
        "label": "Title",
        "valueType": "string"
      },
      {
        "component": "select",
        "name": "teaserStyle",
        "value": "image",
        "label": "Style",
        "valueType": "string",
        "options": [
          {
            "name": "Video",
            "value": "video"
          },
          {
            "name": "Image",
            "value": "image"
          }
        ]
      },
      {
        "component": "select",
        "name": "textPosition",
        "value": "overlay",
        "label": "Text Position",
        "valueType": "string",
        "options": [
          {
            "name": "Overlay (centered on image)",
            "value": "overlay"
          },
          {
            "name": "Beside image – text left",
            "value": "text-left"
          },
          {
            "name": "Beside image – text right",
            "value": "text-right"
          }
        ]
      },
      {
        "component": "container",
        "label": "Video Properties",
        "name": "videoProperties",
        "valueType": "string",
        "condition": {
          "===": [
            {
              "var": "teaserStyle"
            },
            "video"
          ]
        },
        "fields": [
          {
            "component": "text",
            "valueType": "string",
            "name": "videoReference",
            "label": "Video Reference",
            "multi": false,
            "description": "Provide a URL for the video background."
          },
          {
            "component": "select",
            "name": "videoBehavior",
            "value": "autoplay",
            "label": "Video Behavior (on load)",
            "valueType": "string",
            "options": [
              {
                "name": "Autoplay",
                "value": "autoplay"
              },
              {
                "name": "Pause",
                "value": "pause"
              }
            ]
          }
        ]
      },
      {
        "component": "container",
        "label": "Image Properties",
        "name": "imageProperties",
        "valueType": "string",
        "condition": {
          "===": [
            {
              "var": "teaserStyle"
            },
            "image"
          ]
        },
        "fields": [
          {
            "component": "reference",
            "valueType": "string",
            "name": "imageRef",
            "label": "Image",
            "multi": false
          },
          {
            "component": "text",
            "valueType": "string",
            "name": "alt",
            "value": "Default alt",
            "label": "Alt Text"
          }
        ]
      },
