            "component": "text",
            "valueType": "string",
            "name": "buttonLabel",
            "value": "Button",
            "label": "Button Text"
          },
          {
            "component": "aem-content",
            "name": "btn-link",
            "label": "Button Link",
            "valueType": "string",
            "rootPath": "",
            "description": "Path to linked AEM content"
          },
          {
            "component": "select",
            "name": "ctastyle",
            "label": "CTA Style",
            "valueType": "string",
            "value": "button",
            "options": [
              {
                "name": "Default Button",
                "value": "default"
              },
              {
                "name": "Primary Button",
                "value": "button"
              },
              {
                "name": "Secondary Button",
                "value": "button-secondary"
              },
              {
                "name": "Dark Button",
                "value": "button-dark"
              }
            ]
